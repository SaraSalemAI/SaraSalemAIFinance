# Public (safe in the browser): Supabase project URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true ONLY in a controlled demo environment to allow creating demo orgs.
ECC_DEMO_MODE=false
# Never put the service-role key here or in any NEXT_PUBLIC_ variable.
# Edge Function secrets (set with `supabase secrets set`): ANTHROPIC_API_KEY, ECC_APP_ORIGIN
